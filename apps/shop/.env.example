# Sao thành .env.local để đổi địa chỉ API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Số proxy tin cậy trước shop. Các proxy phải thêm IP kết nối vào X-Forwarded-For.
# Giữ 0 khi mở cổng shop trực tiếp. Khi bật, chỉ cho proxy truy cập shop.
# API phải nhận request qua shop hoặc proxy tin cậy, không mở cổng trực tiếp, và đặt TRUST_PROXY=1.
TRUSTED_PROXY_HOPS=0
