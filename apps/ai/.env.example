# Sao thành .env nếu cần; chạy: uv run uvicorn app.main:app_factory --factory --host 127.0.0.1 --port 8000
# Bắt buộc. API nghiệp vụ gửi cùng giá trị này ở header X-Internal-Token (AI_SERVICE_TOKEN bên apps/api).
AI_SERVICE_TOKEN=

# real: nạp BGE-M3 thật (lần đầu tải khoảng 2,2 GB, cần ≥ ~3 GB RAM trống). fake: vector băm, chỉ để thử nhanh và CI.
AI_EMBEDDER=real
AI_MODEL_NAME=BAAI/bge-m3
# Thư mục cache mô hình; để trống thì dùng mặc định của Hugging Face.
AI_MODEL_CACHE=

# Giới hạn mỗi lần gọi: tối đa 64 câu; cắt văn bản quá số token này.
AI_MAX_BATCH=64
AI_MAX_TOKENS=512
