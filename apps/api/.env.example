# Sao thành .env để đổi giá trị mặc định; main.ts tự nạp .env nếu có. Không commit .env.
# Biến đã đặt ở môi trường được ưu tiên hơn .env. Giá trị sai (số hỏng, thiếu bắt buộc) làm server từ chối khởi động.

NODE_ENV=development
PORT=4000

# Nguồn được phép gọi API từ trình duyệt, cách nhau dấu phẩy. Không cho dấu *. Production để trống = không cho nguồn nào.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Lối tắt demo (devCode của OTP, POST /api/dev/reset, nới giới hạn OTP). Mặc định bật khi NODE_ENV khác production.
DEMO_MODE=true

# Bắt buộc khi NODE_ENV=production và phải dài ít nhất 32 ký tự (vd: openssl rand -hex 32).
# Để trống ở dev thì dùng khóa mặc định, ai cũng ký được token, đừng dùng cho dữ liệu thật.
JWT_SECRET=

# Gửi OTP thật qua email. Bắt buộc khi DEMO_MODE=false. Ví dụ: smtp://user:pass@smtp.example.com:587
SMTP_URL=
SMTP_FROM=Farmery <no-reply@farmery.local>

# Kiểm phản hồi theo openapi.yaml. Mặc định bật khi NODE_ENV khác production.
VALIDATE_RESPONSES=true

# Swagger UI ở /docs. Mặc định tắt khi production.
DOCS_ENABLED=true

# Số tầng proxy tin cậy (nginx, load balancer) để lấy đúng IP khách từ X-Forwarded-For; 0 là không có proxy.
# Đặt sai làm giới hạn tần suất tính nhầm IP: sau 1 proxy đặt 1.
TRUST_PROXY=0

# Giới hạn tần suất theo IP trong mỗi cửa sổ; /api/auth/* có trần riêng chặt hơn. /api/health không bị tính.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=600
RATE_LIMIT_AUTH_MAX=30

# Chống gửi dồn và dò mã OTP theo từng email. Mặc định chặt khi DEMO_MODE=false (30 giây, 10 mã/giờ, 10 lần sai/15 phút)
# và nới ở DEMO_MODE để chạy thử liên tục.
OTP_RESEND_COOLDOWN_SECONDS=
OTP_MAX_PER_HOUR=
OTP_MAX_FAILURES_PER_15_MIN=

# Ghi mỗi yêu cầu (mã, phương thức, đường dẫn, mã trạng thái, thời gian; không ghi query/header/body). Mặc định bật ở production.
LOG_REQUESTS=false
