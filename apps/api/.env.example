# Sao thành .env để đổi giá trị mặc định; main.ts tự nạp .env nếu có. Không commit .env.
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Lối tắt demo (devCode của OTP, POST /api/dev/reset). Mặc định bật khi NODE_ENV khác production.
DEMO_MODE=true
# Kiểm phản hồi theo openapi.yaml. Mặc định bật khi NODE_ENV khác production.
VALIDATE_RESPONSES=true
# Bắt buộc khi NODE_ENV=production; để trống thì môi trường dev dùng khóa mặc định.
JWT_SECRET=
