enum SupplierStatus {
  pending
  active
  suspended
  banned

  @@map("supplier_status")
  @@schema("supplier")
}

enum SellerTaxType {
  self_producer
  household_business
  enterprise_coop

  @@map("seller_tax_type")
  @@schema("supplier")
}

enum CertType {
  VietGAP
  GlobalGAP
  organic
  OCOP
  HACCP

  @@map("cert_type")
  @@schema("supplier")
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired

  @@map("approval_status")
  @@schema("supplier")
}

/// Hồ sơ nhà cung cấp — trang nguồn gốc công khai, không phải gian hàng (FR2.1)
model Supplier {
  id              BigInt         @id @default(autoincrement())
  userId          BigInt         @unique @map("user_id")
  displayName     String         @map("display_name") @db.VarChar
  description     String?        @db.Text
  avatarFileId    BigInt?        @map("avatar_file_id")
  growingRegion   String         @map("growing_region") @db.VarChar
  growingAreaCode String?        @map("growing_area_code") @db.VarChar
  areaCheckedBy   BigInt?        @map("area_checked_by")
  taxType         SellerTaxType  @map("tax_type")
  taxCode         String?        @map("tax_code") @db.VarChar
  taxConfirmedBy  BigInt?        @map("tax_confirmed_by")
  status          SupplierStatus @default(pending)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  certifications     Certification[]     @relation("Certification_supplier")
  supportAssignments SupportAssignment[] @relation("SupportAssignment_supplier")

  @@map("suppliers")
  @@schema("supplier")
}

/// Chứng nhận chất lượng (FR3.1–FR3.3); bản đã duyệt không sửa trực tiếp (NFR9.1)
model Certification {
  id                BigInt         @id @default(autoincrement())
  supplierId        BigInt         @map("supplier_id")
  type              CertType
  certificateNumber String         @map("certificate_number") @db.VarChar
  issuingAuthority  String         @map("issuing_authority") @db.VarChar
  evidenceFileId    BigInt         @map("evidence_file_id")
  issuedDate        DateTime       @map("issued_date") @db.Date
  expiryDate        DateTime       @map("expiry_date") @db.Date
  approvalStatus    ApprovalStatus @default(pending) @map("approval_status")
  reviewedBy        BigInt?        @map("reviewed_by")
  reviewedAt        DateTime?      @map("reviewed_at") @db.Timestamp(6)
  supersedesId      BigInt?        @map("supersedes_id")

  supplier       Supplier        @relation("Certification_supplier", fields: [supplierId], references: [id])
  supersedes     Certification?  @relation("Certification_supersedes", fields: [supersedesId], references: [id])
  certifications Certification[] @relation("Certification_supersedes")

  @@map("certifications")
  @@schema("supplier")
}

/// Nhân viên hỗ trợ vùng chỉ truy cập dữ liệu của nhà cung cấp được phân công
model SupportAssignment {
  id          BigInt    @id @default(autoincrement())
  supplierId  BigInt    @map("supplier_id")
  staffUserId BigInt    @map("staff_user_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamp(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamp(6)

  supplier Supplier @relation("SupportAssignment_supplier", fields: [supplierId], references: [id])

  @@map("support_assignments")
  @@schema("supplier")
}
