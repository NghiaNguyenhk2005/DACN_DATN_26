Enum account_status {
  active
  locked
  pending
}

Enum seller_status {
  pending
  active
  suspended
}

Enum verification_status {
  pending
  verified
  rejected
}

Enum cert_type {
  VietGAP
  GlobalGAP
  organic
  OCOP
  HACCP
}

Enum product_status {
  active
  hidden
  pending
}

Enum voucher_scope {
  platform
  shop
}

Enum order_status {
  pending_payment
  confirmed
  processing
  completed
  cancelled
  refunded
}

Enum payment_method {
  cod
  bank_transfer
  vietqr
  e_wallet
}

Enum payment_status {
  pending
  completed
  failed
  refunded
}

Enum holding_type {
  standard
  escrow
}

Enum escrow_status {
  none
  holding
  released
  refunded
}

Enum rfq_status {
  new
  negotiating
  accepted
  rejected
  closed
}

Enum contract_status {
  draft
  awaiting_confirmation
  concluded
  cancelled
}

Enum installment_status {
  pending
  delivering
  delivered
  failed
}

Enum debt_status {
  not_due
  overdue
  settled
}

Enum review_status {
  public
  pending
  hidden
}

Enum case_type {
  complaint
  violation
}

Enum case_status {
  pending_review
  under_investigation
  resolved_refund
  resolved_rejected
  closed
}

Enum notification_type {
  order_status
  rfq_contract
  cert_expiry
  system_announcement
}

Enum notification_channel {
  in_app
  email
  sms
}

Enum ai_insight_type {
  recommendation
  price_forecast
  anomaly_alert
}


// ==============================================================================
// NHÓM 1: TÀI KHOẢN, GIAN HÀNG & PHÂN QUYỀN (FR1)
// ==============================================================================

Table users {
  id bigint [pk, increment]
  full_name varchar [not null]
  email varchar [unique]
  phone varchar [unique, note: 'Kênh nhận OTP (FR1.2)']
  password_hash varchar [note: 'Bcrypt/Argon2 (NFR3.3)']
  status account_status [not null, default: 'active']
  created_at timestamp [not null, default: `now()`]

  note: 'Tài khoản dùng chung cho người mua và người bán'
}

Table addresses {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  recipient_name varchar [not null]
  phone varchar [not null]
  address_line varchar [not null]
  ward varchar
  district varchar
  province varchar [not null]
  is_default boolean [not null, default: false]

  note: 'Sổ địa chỉ giao/nhận hàng (FR1.6)'
}

Table businesses {
  id bigint [pk, increment]
  owner_user_id bigint [not null, unique, ref: > users.id]
  company_name varchar [not null]
  tax_code varchar [unique, not null]
  business_license_file varchar [not null, note: 'File scan GPKD (FR1.3)']
  verification_status verification_status [not null, default: 'pending']

  note: 'Hồ sơ doanh nghiệp thu mua B2B'
}

Table business_members {
  id bigint [pk, increment]
  business_id bigint [not null, ref: > businesses.id]
  user_id bigint [not null, ref: > users.id]
  internal_role varchar [not null, note: 'owner, buyer, accountant, viewer (FR1.4)']

  indexes {
    (business_id, user_id) [unique]
  }

  note: 'Phân quyền nội bộ RBAC trong tài khoản doanh nghiệp'
}

Table shops {
  id bigint [pk, increment]
  owner_user_id bigint [not null, unique, ref: > users.id]
  name varchar [not null]
  description text
  growing_region varchar [note: 'Khu vực canh tác công bố']
  status seller_status [not null, default: 'pending', note: 'eKYC seller (FR1.5)']
  created_at timestamp [not null, default: `now()`]

  note: 'Gian hàng của nông dân/HTX'
}


// ==============================================================================
// NHÓM 2: DANH MỤC, CHỨNG NHẬN, SẢN PHẨM & TRUY XUẤT NGUỒN GỐC (FR2 - FR4)
// ==============================================================================

Table categories {
  id bigint [pk, increment]
  parent_id bigint [ref: > categories.id, note: 'Tự tham chiếu, danh mục đa cấp (FR4.4)']
  name varchar [not null, unique]
}

Table certifications {
  id bigint [pk, increment]
  shop_id bigint [not null, ref: > shops.id]
  type cert_type [not null]
  certificate_number varchar [not null]
  issuing_authority varchar [not null]
  evidence_file varchar [not null]
  issued_date date [not null]
  expiry_date date [not null, note: 'Theo dõi hạn hiệu lực (FR3.3)']
  approval_status verification_status [not null, default: 'pending', note: 'Kiểm duyệt bởi admin (FR3.2)']
  reviewer_id bigint [ref: > users.id]

  note: 'Chứng nhận chất lượng; append-only sau khi duyệt (NFR9.1)'
}

Table products {
  id bigint [pk, increment]
  shop_id bigint [not null, ref: > shops.id]
  category_id bigint [not null, ref: > categories.id]
  name varchar [not null]
  description text
  image_urls json
  unit varchar [not null, note: 'kg, tấn, thùng... (FR4.1)']
  retail_price decimal(14,2) [not null]
  status product_status [not null, default: 'pending']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  note: 'Thông tin đăng bán; tồn kho thực tế theo dõi ở cấp lô hàng (batches)'
}

Table wholesale_price_tiers {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  min_quantity decimal(12,2) [not null]
  unit_price decimal(14,2) [not null]

  indexes {
    (product_id, min_quantity) [unique]
  }

  note: 'Bậc giá theo số lượng mua sỉ (FR4.1, FR6.4)'
}

Table batches {
  id bigint [pk, increment]
  product_id bigint [not null, ref: > products.id]
  batch_code varchar [unique, not null]
  harvest_date date [not null]
  expiry_date date [not null]
  stock_quantity decimal(12,2) [not null, default: 0, note: 'Tồn kho của lô, không âm (NFR1.2)']
  qr_code varchar [unique, not null, note: 'Mã QR truy xuất nguồn gốc (FR4.2)']
  created_at timestamp [not null, default: `now()`]

  note: 'Lô hàng - đơn vị cốt lõi quản lý tồn kho và truy xuất nguồn gốc'
}

Table farming_logs {
  id bigint [pk, increment]
  batch_id bigint [not null, ref: > batches.id]
  activity_date date [not null]
  activity varchar [not null, note: 'Gieo trồng, bón phân, thu hoạch...']
  description text
  images json
  is_published boolean [not null, default: false, note: 'Công khai qua QR; true -> không sửa trực tiếp (NFR9.1)']

  note: 'Nhật ký canh tác theo lô (FR4.2)'
}


// ==============================================================================
// NHÓM 3: GIỎ HÀNG & KHUYẾN MÃI
// ==============================================================================

Table carts {
  id bigint [pk, increment]
  user_id bigint [not null, unique, ref: > users.id]
  updated_at timestamp [not null, default: `now()`]
}

Table cart_items {
  id bigint [pk, increment]
  cart_id bigint [not null, ref: > carts.id]
  product_id bigint [not null, ref: > products.id]
  quantity decimal(12,2) [not null]

  indexes {
    (cart_id, product_id) [unique]
  }
}

Table vouchers {
  id bigint [pk, increment]
  code varchar [not null, unique]
  scope voucher_scope [not null]
  shop_id bigint [ref: > shops.id, note: 'Null khi áp dụng toàn sàn']
  discount_percent decimal(5,2) [not null]
  max_discount decimal(14,2)
  min_order_amount decimal(14,2) [not null, default: 0]
  usage_limit int
  expires_at timestamp

  note: 'Mã giảm giá cấp sàn hoặc gian hàng (FR5.3)'
}


// ==============================================================================
// NHÓM 4: ĐƠN HÀNG & THANH TOÁN B2C (FR5, FR7)
// ==============================================================================

Table orders {
  id bigint [pk, increment]
  buyer_user_id bigint [not null, ref: > users.id]
  shop_id bigint [not null, ref: > shops.id]
  address_id bigint [not null, ref: > addresses.id, note: 'Địa chỉ giao tại thời điểm đặt (FR1.6)']
  voucher_id bigint [ref: > vouchers.id]
  status order_status [not null, default: 'pending_payment']
  subtotal decimal(14,2) [not null]
  discount_amount decimal(14,2) [not null, default: 0]
  shipping_fee decimal(14,2) [not null, default: 0]
  total_amount decimal(14,2) [not null]
  created_at timestamp [not null, default: `now()`]

  note: 'Một đơn thuộc một gian hàng; một lần checkout nhiều gian hàng tạo nhiều đơn (FR5.2)'
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  batch_id bigint [not null, ref: > batches.id, note: 'Gắn đúng lô xuất hàng để truy vết nguồn gốc (FR4.3)']
  product_name varchar [not null, note: 'Ảnh chụp tên sản phẩm tại thời điểm mua']
  quantity decimal(12,2) [not null]
  unit_price decimal(14,2) [not null, note: 'Ảnh chụp giá tại thời điểm mua']
  line_total decimal(14,2) [not null]

  note: 'Chi tiết đơn hàng; lưu ảnh chụp để giữ lịch sử khi sản phẩm đổi tên/giá'
}

Table payments {
  id bigint [pk, increment]
  order_id bigint [unique, ref: > orders.id, note: 'Thanh toán đơn B2C']
  contract_id bigint [unique, ref: > contracts.id, note: 'Thanh toán gộp hợp đồng B2B']
  installment_id bigint [unique, ref: > delivery_installments.id, note: 'Thanh toán theo đợt giao B2B']
  method payment_method [not null]
  status payment_status [not null, default: 'pending']
  amount decimal(14,2) [not null]
  holding_type holding_type [not null, default: 'standard']
  escrow_status escrow_status [not null, default: 'none', note: 'Giữ tiền trung gian (FR7.4)']
  gateway_transaction_id varchar
  paid_at timestamp
  released_at timestamp [note: 'Thời điểm giải ngân escrow cho người bán']
  created_at timestamp [not null, default: `now()`]

  note: 'Chỉ gắn đúng một trong order_id/contract_id/installment_id tại một thời điểm'
}


// ==============================================================================
// NHÓM 5: GIAO DỊCH B2B (FR6, FR7)
// ==============================================================================

Table rfqs {
  id bigint [pk, increment]
  business_id bigint [not null, ref: > businesses.id]
  shop_id bigint [not null, ref: > shops.id]
  product_id bigint [not null, ref: > products.id]
  requested_quantity decimal(12,2) [not null, note: 'FR6.1']
  desired_delivery_time date [not null]
  quality_standard varchar
  status rfq_status [not null, default: 'new']
  created_at timestamp [not null, default: `now()`]

  note: 'Yêu cầu báo giá bán sỉ B2B'
}

Table rfq_negotiations {
  id bigint [pk, increment]
  rfq_id bigint [not null, ref: > rfqs.id]
  sender_user_id bigint [not null, ref: > users.id]
  proposed_quantity decimal(12,2) [not null]
  proposed_unit_price decimal(14,2) [not null]
  message text
  sent_at timestamp [not null, default: `now()`]

  note: 'Lịch sử thương lượng RFQ (FR6.2)'
}

Table contracts {
  id bigint [pk, increment]
  rfq_id bigint [not null, unique, ref: > rfqs.id]
  agreed_quantity decimal(12,2) [not null]
  agreed_unit_price decimal(14,2) [not null]
  payment_terms varchar [note: 'Net 15, Net 30... (FR6.5)']
  contract_file varchar [not null]
  status contract_status [not null, default: 'draft']
  concluded_at timestamp

  note: 'Hợp đồng điện tử hình thành từ RFQ (FR6.3)'
}

Table delivery_installments {
  id bigint [pk, increment]
  contract_id bigint [not null, ref: > contracts.id]
  quantity decimal(12,2) [not null]
  planned_delivery_date date [not null]
  status installment_status [not null, default: 'pending']

  note: 'Kế hoạch giao hàng theo đợt trên hợp đồng (FR6.5)'
}

Table debts {
  id bigint [pk, increment]
  contract_id bigint [not null, ref: > contracts.id]
  installment_id bigint [ref: > delivery_installments.id, note: 'Null nếu công nợ tính gộp cả hợp đồng']
  amount decimal(14,2) [not null]
  due_date date [not null]
  status debt_status [not null, default: 'not_due']

  note: 'Công nợ thương mại B2B (FR6.5)'
}


// ==============================================================================
// NHÓM 6: ĐÁNH GIÁ, KHIẾU NẠI, THÔNG BÁO (FR5.5, FR8.3, FR10, FR11)
// ==============================================================================

Table reviews {
  id bigint [pk, increment]
  order_item_id bigint [not null, unique, ref: > order_items.id]
  user_id bigint [not null, ref: > users.id]
  rating int [not null, note: '1 - 5 sao']
  content text
  images json
  status review_status [not null, default: 'public']
  seller_reply text
  created_at timestamp [not null, default: `now()`]

  note: 'Đánh giá sản phẩm/gian hàng sau khi mua (FR5.5)'
}

Table wishlist_items {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  product_id bigint [not null, ref: > products.id]
  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, product_id) [unique]
  }
}

Table cases {
  id bigint [pk, increment]
  case_type case_type [not null, note: 'complaint (FR8.3) hoặc violation (FR10.2)']
  order_id bigint [ref: > orders.id, note: 'Khiếu nại B2C (nullable)']
  installment_id bigint [ref: > delivery_installments.id, note: 'Khiếu nại B2B (nullable)']
  accused_shop_id bigint [ref: > shops.id, note: 'Gian hàng bị khiếu nại/vi phạm (nullable)']
  reporter_user_id bigint [ref: > users.id]
  reason varchar [not null]
  description text
  evidence_files json
  status case_status [not null, default: 'pending_review']
  resolution_note text
  handled_by bigint [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
  resolved_at timestamp

  note: 'Gộp khiếu nại đơn hàng và vi phạm chính sách để giảm số bảng quản trị'
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  title varchar [not null]
  content text [not null]
  type notification_type [not null]
  channel notification_channel [not null, default: 'in_app']
  is_read boolean [not null, default: false]
  metadata json [note: 'order_id, rfq_id, batch_id... để điều hướng']
  created_at timestamp [not null, default: `now()`]

  note: 'Thông báo đa kênh (FR11)'
}


// ==============================================================================
// NHÓM 7: KHUNG AI TỐI THIỂU (FR12)
// ==============================================================================

Table ai_insights {
  id bigint [pk, increment]
  insight_type ai_insight_type [not null]
  target_type varchar [not null, note: 'user, product, category tùy insight_type']
  target_id bigint [not null]
  payload json [not null, note: 'Chi tiết kết quả: điểm gợi ý/giá dự báo/mô tả bất thường']
  generated_at timestamp [not null, default: `now()`]

  note: 'Bảng kết quả AI dùng chung cho gợi ý, dự báo giá và cảnh báo bất thường (FR12.1-FR12.3)'
}


// ==============================================================================
// NHÓM TRỰC QUAN HÓA
// ==============================================================================

TableGroup Nhom1_TaiKhoan_GianHang {
  users
  addresses
  businesses
  business_members
  shops
}

TableGroup Nhom2_DanhMuc_TruyXuat_SanPham {
  categories
  certifications
  products
  wholesale_price_tiers
  batches
  farming_logs
}

TableGroup Nhom3_GioHang_KhuyenMai {
  carts
  cart_items
  vouchers
}

TableGroup Nhom4_DonHang_ThanhToan_B2C {
  orders
  order_items
  payments
}

TableGroup Nhom5_GiaoDich_B2B {
  rfqs
  rfq_negotiations
  contracts
  delivery_installments
  debts
}

TableGroup Nhom6_DanhGia_KhieuNai_ThongBao {
  reviews
  wishlist_items
  cases
  notifications
}

TableGroup Nhom7_AI {
  ai_insights
}